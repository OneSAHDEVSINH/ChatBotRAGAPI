{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
    "Rag": {
        "DataDirectory": "data",
        "UseInMemoryVectorStore": true,
        "UseLocalAiFallback": false,
        "QdrantBaseUrl": "http://localhost:6333",
        "QdrantCollection": "knowledge",
        "EmbeddingModel": "nomic-embed-text",
        "ChatModel": "phi3:mini",//"llama3.1:8b",
        "OllamaBaseUrl": "http://localhost:11434",
        "ChunkSize": 700,
        "ChunkOverlap": 80,
        "TopK": 3,
        "MinScore": 0.45,
        "LocalMinScore": 0.08,
        "EmbeddingBatchSize": 32,
        "DisableThinking": true,
        "EmbeddingDimensions": 768,
        "MaxGenerateTokens": 180,
        "NumCtx": 2048,
        "KeepAlive": "10m"
    }
}