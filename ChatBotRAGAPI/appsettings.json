{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "ApiKey": ""
  },
  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 10,
    "QueueLimit": 10
  },
    "Rag": {
        "DataDirectory": "data",
        "UseInMemoryVectorStore": true,
        "UseLocalAiFallback": false,
        "QdrantBaseUrl": "http://localhost:6333",
        "QdrantCollection": "knowledge",
        "EmbeddingModel": "text-embedding-nomic:latest",
        "ChatModel": "gpt-5-qwen3:latest",
        "OllamaBaseUrl": "http://localhost:11434",
        "ChunkSize": 700,
        "ChunkOverlap": 80,
        "TopK": 3,
        "MinScore": 0.45,
        "LocalMinScore": 0.08,
        "EmbeddingBatchSize": 32,
        "DisableThinking": true,
        "MaxHistoryMessages": 6,
        "EmbeddingDimensions": 768,
        "MaxGenerateTokens": 180,
        "NumCtx": 2048,
        "KeepAlive": "10m"
    }
}