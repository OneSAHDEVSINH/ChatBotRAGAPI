{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "ApiKey": ""
  },
  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 10,
    "QueueLimit": 10
  },
  "Authentication": {
    "Entra": {
      "TenantId": "",
      "ClientId": "",
      "Instance": "https://login.microsoftonline.com/",
      "AdminRole": "Chat.Admin"
    }
  },
  "Widget": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
    "Rag": {
        "DataDirectory": "data",
        "UseInMemoryVectorStore": true,
        "UseLocalAiFallback": false,
        "QdrantBaseUrl": "http://127.0.0.1:6333",
        "QdrantCollection": "knowledge",
        "EmbeddingModel": "text-embedding-nomic:latest",
        "ChatModel": "gpt-5-qwen3:latest",
        "OcrModel": "",
        "OcrMaxTokens": 2048,
        "OllamaBaseUrl": "http://127.0.0.1:11434",
        "ChatProvider": "Ollama",
        "EmbeddingProvider": "Ollama",
        "OpenAI": {
            "ApiKey": "",
            "Endpoint": "",
            "MaxOutputTokens": 16000
        },
        "Anthropic": {
            "ApiKey": "",
            "MaxTokens": 16000
        },
        "ChunkSize": 700,
        "ChunkOverlap": 80,
        "TopK": 3,
        "MinScore": 0.45,
        "LocalMinScore": 0.08,
        "EmbeddingBatchSize": 32,
        "PrioritizeChat": true,
        "ChatPriorityMaxWaitSeconds": 30,
        "FeedbackMaxFileMB": 20,
        "UsageMaxFileMB": 50,
        "AuditMaxFileMB": 20,
        "UsageStoreQuestions": true,
        "MaxCrawlPages": 50,
        "CrawlDelayMilliseconds": 500,
        "HybridSearch": true,
        "MinKeywordCoverage": 1.0,
        "SearchCandidates": 20,
        "DisableThinking": true,
        "MaxHistoryMessages": 6,
        "RewriteFollowUps": true,
        "Rerank": false,
        "RerankCandidates": 10,
        "EmbeddingDimensions": 768,
        "MaxGenerateTokens": 180,
        "NumCtx": 2048,
        "KeepAlive": "10m"
    }
}