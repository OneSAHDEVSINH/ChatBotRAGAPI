<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML docs feed Swagger's descriptions; not every public member (or parameter) needs one. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AngleSharp" Version="1.9.1" />
		<PackageReference Include="ClosedXML" Version="0.105.1" />
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
		<PackageReference Include="PdfPig" Version="0.1.16" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
	</ItemGroup>

</Project>
