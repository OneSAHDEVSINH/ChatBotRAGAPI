{
  "info": {
    "name": "ChatBotRAGAPI",
    "description": "Requests for every endpoint. Set the collection variables first: baseUrl, and apiKey when the server has Security:ApiKey set (sent as X-Api-Key to ingestion and document endpoints; chat and health are open). Upload/scrape store the returned jobId for 'Job status'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5170"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "source",
      "value": "company_profile.txt"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Api-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingestion",
      "item": [
        {
          "name": "Scrape URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ingestion/scrape",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ingestion",
                "scrape"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Public http(s) URLs only; private/loopback addresses are rejected."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set('jobId', pm.response.json().jobId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crawl site",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ingestion/scrape",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ingestion",
                "scrape"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/\",\n  \"maxPages\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Follows links on the same host and under the same path, honouring robots.txt, up to maxPages (max Rag:MaxCrawlPages, default 50). Each page becomes its own document named by its URL; the job message reports how many pages were ingested."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set('jobId', pm.response.json().jobId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload file",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ingestion/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ingestion",
                "upload"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "description": "txt, csv, docx, xlsx or pdf. Choose the file in the Body tab. Re-uploading the same file name replaces that document."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set('jobId', pm.response.json().jobId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Job status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ingestion/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ingestion",
                "{{jobId}}"
              ]
            },
            "description": "Queued -> Running -> Completed | Failed (with message)."
          }
        }
      ]
    },
    {
      "name": "Chat",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Ask",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "ask"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"When was the company founded?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Ask follow-up (with history)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "ask"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"And where is the head office?\",\n  \"history\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"When was the company founded?\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"The company was founded in 2016 [1].\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The server keeps no conversation state: send earlier turns as history."
          }
        },
        {
          "name": "Ask (streaming, SSE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat/ask/stream",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "ask",
                "stream"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"When was the company founded?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Server-Sent Events: sources, context (passage texts), then delta..., then done (or error). Accepts history too."
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "List documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents"
              ]
            }
          }
        },
        {
          "name": "Delete document",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents?source={{source}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents"
              ],
              "query": [
                {
                  "key": "source",
                  "value": "{{source}}"
                }
              ]
            },
            "description": "source = file name or URL exactly as listed (URL-encode URLs)."
          }
        }
      ]
    }
  ]
}